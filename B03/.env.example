# GreenMate B03 天气 API 配置
#
# 使用方式：复制此文件为 .env，填入需要的值
# 终端传参优先级高于此文件中的配置
#
# Open-Meteo 免费版无需 API Key
# 商业版申请：https://open-meteo.com/en/pricing

# 商业版 API Key（免费版不填）
# OPEN_METEO_API_KEY=

# 默认温室位置（预置城市名）
# 可选：北京大兴、北京顺义、河北固安、山东寿光、上海崇明、浙江嘉善、广东广州、海南三亚、江苏南京
DEFAULT_LOCATION=北京大兴

# 默认预测窗口
# now   - 当前实况
# 1h/3h/6h/12h - 未来N小时预测
# 1d    - 明天平均
# 3d    - 未来3天平均
DEFAULT_FORECAST_WINDOW=now

# API 超时时间（秒）
API_TIMEOUT=10

# API 重试次数
API_MAX_RETRIES=3

# 预置温室位置坐标（不可修改）
# 北京大兴: 39.73, 116.33
# 北京顺义: 40.13, 116.65
# 河北固安: 39.44, 116.30
# 山东寿光: 36.88, 118.79
# 上海崇明: 31.62, 121.45
# 浙江嘉善: 30.85, 120.93
# 广东广州: 23.16, 113.23
# 海南三亚: 18.25, 109.51
# 江苏南京: 32.06, 118.79
