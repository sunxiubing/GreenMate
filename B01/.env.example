# 复制成 .env 再填真实值：copy .env.example .env
#
# 书写要求（踩过坑）：
#   - 不要加引号，不要写 export
#   - = 两边不要留空格
#   - 文件编码用 UTF-8 无 BOM
#
# 改完 .env 必须【重启服务】才生效 —— 它在进程启动时读进内存，
# 之后改文件对运行中的进程毫无影响。重启后看启动日志第 3 行的 key 指纹确认。

# OpenAI 兼容的 LLM 服务地址（本项目用阿里云百炼 MaaS 工作空间）
LLM_BASE_URL=https://<你的工作空间ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 密钥。不要提交进 Git —— .gitignore 已排除 .env
LLM_API_KEY=sk-在这里填你的密钥

# 模型名
LLM_MODEL=qwen3.5-27b
