# GreenMate 环境变量模板（根目录汇总版）
#
# 使用方式：复制本文件为对应模块的 .env 再填真实值
#   copy .env.example B01\.env    （LLM 三项，路线 A 必填）
#   copy .env.example B03\.env    （天气各项，可选）
#
# 书写要求（踩过坑）：
#   - 不要加引号，不要写 export
#   - = 两边不要留空格
#   - 文件编码用 UTF-8 无 BOM
#
# 改完 .env 必须【重启服务】才生效 —— 它在进程启动时读进内存，
# 之后改文件对运行中的进程毫无影响。重启后看启动日志第 3 行的 key 指纹确认。
#
# ─────────────────────────────────────────────
# 一、LLM 配置（B01，路线 A 必填；不填走路线 B 降级）
# ─────────────────────────────────────────────

# OpenAI 兼容的 LLM 服务地址（本项目用阿里云百炼 MaaS 工作空间）
LLM_BASE_URL=https://<你的工作空间ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 密钥。不要提交进 Git —— .gitignore 已排除 .env
LLM_API_KEY=sk-在这里填你的密钥

# 模型名
LLM_MODEL=qwen3.5-27b

# ─────────────────────────────────────────────
# 二、天气 API 配置（B03，全部可选，免费版无需 Key）
#    Open-Meteo 免费版无需 API Key
#    商业版申请：https://open-meteo.com/en/pricing
# ─────────────────────────────────────────────

# 商业版 API Key（免费版不填）
# OPEN_METEO_API_KEY=

# 默认温室位置（预置城市名）
# 可选：北京大兴、北京顺义、河北固安、山东寿光、上海崇明、浙江嘉善、广东广州、海南三亚、江苏南京
DEFAULT_LOCATION=北京大兴

# 默认预测窗口
# now   - 当前实况
# 1h/3h/6h/12h - 未来N小时预测
# 1d    - 明天平均
# 3d    - 未来3天平均
DEFAULT_FORECAST_WINDOW=now

# API 超时时间（秒）
API_TIMEOUT=10

# API 重试次数
API_MAX_RETRIES=3
